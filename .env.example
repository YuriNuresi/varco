# Copia in .env e compila con le credenziali del MySQL OVH.
# In locale config.php legge questo file; in produzione puoi anche
# modificare direttamente i define() in config.php.

DB_HOST=localhost
DB_NAME=magic_game
DB_USER=root
DB_PASS=
DB_PORT=3306

# Chiave per l'endpoint video_manifest.php (da mettere anche nei secret GitHub come MANIFEST_SECRET)
MANIFEST_SECRET=cambia-questa-chiave

# Jamendo API key per la musica automatica (gratuita — registrati su https://developer.jamendo.com)
# Opzionale: senza questa chiave il manifesto usa i mp3 locali in magic/assets/music/
JAMENDO_CLIENT_ID=

# --- Google OAuth (login admin) -----------------------------------------------
# Le credenziali Google sono nel .env di root (~/.env), condivise con Helios.
# Qui puoi sovrascrivere il redirect URI specifico per Varco.
GOOGLE_REDIRECT_URI_VARCO=https://varco.portale3d.it/auth_callback.php

# --- Faro (gestionale traffico/monetizzazione cross-game) ---------------------
# Salt casuale lungo per gli hash di IP/UA (anti-spam senza memorizzare PII).
FARO_IP_SALT=
# Segreto per firmare/verificare i callback revenue server-to-server (HMAC).
FARO_S2S_SECRET=
# Origini ammesse per il beacon JS (CORS): i domini dei giochi, separati da virgola.
# Es: https://varco.tuodominio.it,https://helios.tuodominio.it  (oppure * in dev)
FARO_ALLOWED_ORIGINS=*
