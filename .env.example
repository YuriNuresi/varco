# Copia in .env e compila con le credenziali del MySQL OVH.
# In locale config.php legge questo file; in produzione puoi anche
# modificare direttamente i define() in config.php.

DB_HOST=localhost
DB_NAME=magic_game
DB_USER=root
DB_PASS=
DB_PORT=3306

# Chiave per l'endpoint video_manifest.php (da mettere anche nei secret GitHub come MANIFEST_SECRET)
MANIFEST_SECRET=cambia-questa-chiave

# Jamendo API key per la musica automatica (gratuita — registrati su https://developer.jamendo.com)
# Opzionale: senza questa chiave il manifesto usa i mp3 locali in magic/assets/music/
JAMENDO_CLIENT_ID=
